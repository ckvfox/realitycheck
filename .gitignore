# --- Security & local config ---
.env
*.env
env.txt
analysis-private/real-wages-auth.php

# --- Python cache ---
__pycache__/
*.pyc

# --- System files ---
.DS_Store
Thumbs.db
serve.py

# --- Local FTP deployment bundles (never commit) ---
deployment/
